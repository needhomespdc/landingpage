# Backend API base URL (must include /api). Do NOT point this at the Next.js app origin.
# Local Nest: http://localhost:3000/api  (run landing on another port, e.g. next dev -p 3001)
# Production:
NEXT_PUBLIC_API_URL=https://api.needhomespdc.com/api

# Investor/app URL used by CTAs
NEXT_PUBLIC_APP_URL=https://app.needhomespdc.com
